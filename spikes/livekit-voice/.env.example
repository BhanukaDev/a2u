# LiveKit Cloud project (cloud.livekit.io -> Settings -> Keys)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

DEEPGRAM_API_KEY=
# CARTESIA_API_KEY=             # only needed with TTS_PROVIDER=cartesia
GOOGLE_API_KEY=                 # Gemini API key (aistudio.google.com)
# ANTHROPIC_API_KEY=            # only needed with LLM_PROVIDER=anthropic

# Optional defaults. The test page can override all of these per call.
# STORY=...                      # system prompt; easier to edit on the page
# LLM_PROVIDER=gemini           # or anthropic, or echo (no LLM: speech-only floor)
# LLM_MODEL=                    # default gemini-3.5-flash (gemini) / claude-haiku-4-5 (anthropic)
# STT_PROVIDER=deepgram         # or gemini (Sinhala / Tamil / code-mixed)
# STT_LANGUAGE=en-US            # deepgram only
# STT_LANGUAGES=si-LK,en-US     # gemini only; empty = auto-detect
# TTS_PROVIDER=deepgram         # or cartesia, or gemini (speaks Sinhala; not streaming, slower)
# TTS_VOICE=                    # aura-2-<name>-en (deepgram), voice name (gemini, default Kore), voice ID (cartesia)
# TTS_INSTRUCTIONS=             # gemini only: speaking style, e.g. "Speak calmly, at a measured pace."
# GREETING=Hi, thank you for calling ABC Bank. This is Nadeesha. How can I help you today?
# ENDPOINT_MIN_DELAY=0.5        # silence (s) before ending a turn the detector thinks is finished
# ENDPOINT_MAX_DELAY=1.2        # ... and one it thinks is unfinished (LiveKit default 3.0)

# Demo bank (demo_bank.py): customer NIC is 2002177. Pin the registered mobile here;
# unset = any valid 07XXXXXXXX number is accepted.
# DEMO_MOBILE=0771234567
